<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#ff007f">
<meta name="description" content="Diario calorico manuale in stile 80s Aerobic Fitness.">
<title>Bilancio Calorico v5.19 · 80s Aerobic Edition</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --bg: #12091f;
  --panel: #201335;
  --panel-inner: #ffffff;
  --text: #ffffff;
  --text-dark: #12091f;
  --magenta: #ff007f;
  --cyan: #00f0ff;
  --yellow: #ffee00;
  --green: #39ff14;
  --border: 3px solid #000000;
  --retro-shadow: 4px 4px 0px #000000;
  --radius: 8px;
}

*{box-sizing:border-box; -webkit-tap-highlight-color: transparent;}
body{
  margin:0;
  background-color: var(--bg);
  background-image: linear-gradient(135deg, #1b0c30 0%, #0d0617 100%);
  color: var(--text);
  font: 14px/1.4 'Space Grotesk', sans-serif;
  min-height: 100vh;
}

button, input, select{font:inherit}
button{cursor:pointer; border:0; background:transparent}

main{max-width:760px; margin:auto; padding:16px 14px 110px}

.top{display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:18px}
.brand{
  background: var(--yellow);
  color: var(--text-dark);
  font-size: 11px;
  letter-spacing: .15em;
  text-transform: uppercase;
  font-weight: 900;
  padding: 4px 8px;
  border: var(--border);
  box-shadow: 2px 2px 0px #000;
  display: inline-block;
  transform: rotate(-1deg);
}
.top h1{font-size: 24px; letter-spacing: -.03em; margin: 4px 0 0; font-weight: 900; text-transform: uppercase; color: var(--cyan); text-shadow: 2px 2px 0px #000;}

.dateinput-wrap{
  background: var(--panel);
  border: var(--border);
  border-radius: var(--radius);
  padding: 6px 10px;
  box-shadow: var(--retro-shadow);
}
.dateinput{
  background: transparent;
  border: 0;
  color: var(--text);
  font-size: 13px;
  font-weight: 900;
  color-scheme: dark;
  outline: none;
  cursor: pointer;
}

/* Griglia Profilo Dedicata */
.profile-grid{display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:14px}
.profileitem{
  background: var(--panel);
  border: var(--border);
  border-radius: var(--radius);
  padding: 12px 10px;
  box-shadow: var(--retro-shadow);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.profileitem label{display:block; font-size:10px; color: var(--cyan); text-transform:uppercase; letter-spacing:.05em; margin-bottom:6px; font-weight:900; text-align:center}

/* Stile unificato per il selettore Sesso */
.profileitem select{
  width:100%;
  background: transparent;
  border: 0;
  color: var(--text);
  padding: 6px 2px;
  outline: none;
  font-weight: 900;
  font-size: 16px;
  text-align-last: center;
  color-scheme: dark;
}
.profileitem select option{background:var(--panel); color: #fff;}

.stepper{
  display:flex; 
  align-items:center; 
  justify-content:space-between; 
  width:100%; 
  gap:6px;
}
.stepper button{
  flex:0 0 32px; width:32px; height:32px; padding:0;
  border: 2px solid #000;
  border-radius: 6px;
  background: var(--magenta);
  color: #fff;
  font-weight: 900;
  font-size: 16px;
  display: grid;
  place-items: center;
  box-shadow: 2px 2px 0px #000;
}
.stepper button:active{transform: translate(1px, 1px); box-shadow:none}

.profileitem input,
.stepper input {
  box-sizing: border-box;
  width: 100%;
  padding: 6px 2px;
  text-align: center;
  font-variant-numeric: tabular-nums;
  border: 0;
  background: transparent;
  color: var(--text);
  font-weight: 900;
  font-size: 16px;
  -webkit-appearance: none;
  -moz-appearance: textfield;
}
.stepper input::-webkit-inner-spin-button,
.stepper input::-webkit-outer-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

.targetbox{
  display: grid;
  grid-template-columns: minmax(0,1fr) auto;
  align-items: center;
  gap: 10px 14px;
  padding: 14px;
  background: var(--panel);
  border: var(--border);
  border-radius: var(--radius);
  box-shadow: var(--retro-shadow);
  margin-bottom: 12px;
}
.targetbox .box-title{font-size: 11px; color: var(--text); font-weight: 900; text-transform: uppercase}
.targetbox .box-value{display:flex; align-items:center; justify-content:flex-end; gap:6px}

/* Cifre perfettamente omogenee tra BMR e Target */
.targetbox .value-number,
.targetbox input {
  color: var(--green);
  font-size: 18px;
  font-weight: 900;
  font-family: 'Space Grotesk', sans-serif;
  font-variant-numeric: tabular-nums;
}
.targetbox input{
  background:transparent;
  border:0;
  width:85px;
  text-align:right;
  outline:none;
  padding:0;
}
.targetbox input[aria-invalid="true"]{color:var(--yellow); text-decoration:underline wavy var(--yellow)}
.targetbox .target-units{color:var(--cyan); font-size:11px; font-weight:900}

.info-toggle{
  flex: 0 0 26px; width: 26px; height: 26px; padding: 0;
  display: inline-grid; place-items: center;
  border: 2px solid #000;
  background: var(--yellow);
  color: var(--text-dark);
  border-radius: 50%;
  font-size: 12px; font-weight: 900;
  box-shadow: 2px 2px 0px #000;
}
.info-toggle:active{transform: translate(1px, 1px); box-shadow:none}
.targetbox .tefbox{grid-column:1 / -1; margin-top:8px}
.targetbox .validation-note{grid-column:1 / -1; color:var(--yellow); font-size:10px; margin-top:4px; font-weight:900}

.card{
  background: var(--panel);
  border: var(--border);
  border-radius: var(--radius);
  padding: 16px;
  box-shadow: var(--retro-shadow);
  margin-bottom: 16px;
}

.hero{
  background: var(--magenta);
  color: #fff;
  border: 4px solid #000;
  box-shadow: 6px 6px 0px #000;
  padding: 20px 16px;
}
.herotop{display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:12px}
.eyebrow{font-size:11px; color:var(--yellow); letter-spacing:.1em; text-transform:uppercase; font-weight:900}
.daylabel{font-size:13px; color:#fff; font-weight:900}

.steps-top{
  display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:12px;
  padding:14px 16px; margin-bottom:14px;
  background: var(--green);
  color: var(--text-dark);
  border: var(--border);
  border-radius: var(--radius);
  box-shadow: var(--retro-shadow);
}
.steps-top label{display:block; font-size:12px; font-weight:900; text-transform:uppercase; color:var(--text-dark)}
.steps-top .hint{margin:0; font-size:10px; color:var(--text-dark); font-weight:700}
.steps-input{display:flex; align-items:center; gap:8px}
.steps-input input{
  width:105px; background:#fff; border: 2px solid #000; border-radius: 6px;
  color:var(--text-dark); font-size:18px; font-weight:900; text-align:center; padding:6px 4px;
  box-shadow: 2px 2px 0px #000;
}
.steps-input input::-webkit-inner-spin-button,
.steps-input input::-webkit-outer-spin-button {
  -webkit-appearance: none;
  margin: 0;
}
.steps-input span{font-size:14px; color:var(--text-dark); font-weight:900}

.balance-visual{
  padding:18px 12px; margin-top:10px; border-radius: var(--radius);
  background: #fff;
  color: var(--text-dark);
  border: var(--border);
  box-shadow: 3px 3px 0px #000;
}
.balance-caption{text-transform:uppercase; letter-spacing:.1em; color:#000; font-size:10px; font-weight:900; text-align:center}
.balance-delta{
  font-size:clamp(36px, 9vw, 52px); font-weight:950; letter-spacing:-.04em; line-height:1;
  text-align:center; margin:8px 0 4px; color:#000; font-variant-numeric:tabular-nums;
}
.balance-delta.deficit{color: #0044ff}
.balance-delta.surplus{display:block; color: #ff0000; margin:8px 0 4px}
.balance-sub{text-align:center; font-size:11px; color:#333; font-weight:700; margin-bottom:14px}

.balance-poles{display:grid; grid-template-columns:1fr auto 1fr; gap:8px; align-items:center}
.balance-pole{
  min-width:0; padding:10px 8px; border-radius: 6px;
  background: var(--cyan); border: 2px solid #000; text-align:center;
  box-shadow: 2px 2px 0px #000;
}
.balance-pole small{display:block; color:#000; font-size:9px; text-transform:uppercase; font-weight:900}
.balance-pole strong{display:block; font-size:clamp(16px, 4vw, 22px); font-weight:900; color:#000; margin-top:2px}
.balance-vs{font-size:11px; color:#000; font-weight:900}

.balance-track{height:10px; border-radius:99px; background:#ddd; position:relative; margin:18px 4px 8px; border: 2px solid #000; overflow:visible}
.balance-track:before{content:""; position:absolute; left:50%; top:-4px; bottom:-4px; width:3px; background:#000}
.balance-marker{
  position:absolute; left:50%; top:50%; width:18px; height:18px; border-radius:50%;
  background: var(--yellow); border: 2px solid #000; transform:translate(-50%,-50%);
  box-shadow: 2px 2px 0px #000; transition:left .25s ease;
}
.balance-marker.deficit{background: var(--cyan)}
.balance-marker.surplus{background: var(--magenta)}
.balance-scale{display:flex; justify-content:space-between; color:#000; font-size:10px; font-weight:900; text-transform:uppercase}

.numbers{display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-top:14px}
.numcard{
  background: #fff; border: 2px solid #000; border-radius: 6px; padding: 10px 8px; text-align:left;
  box-shadow: 2px 2px 0px #000; color: #000;
}
.numlabel{font-size:9px; color:#555; font-weight:900; text-transform:uppercase}
.numvalue{font-size:clamp(15px, 3.5vw, 19px); font-weight:900; margin:4px 0 0; white-space:nowrap; color:#000}
.numvalue small{font-size:9px; color:#555; font-weight:900}
.remaining{color:#007700}
.hint{font-size:11px; color:var(--cyan); margin-top:4px; font-weight:700}

.home-actions{display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:16px}
.home-actions button{
  display:flex; align-items:center; justify-content:center; gap:8px; min-width:0;
  border: var(--border); border-radius: var(--radius); padding: 14px 10px;
  font-size:12px; font-weight:900; text-transform:uppercase;
  box-shadow: var(--retro-shadow); transition: transform 0.05s;
}
.home-actions button:active{transform: translate(2px, 2px); box-shadow:none}
.home-actions .food-action{background: var(--yellow); color: var(--text-dark)}
.home-actions .activity-action{background: var(--cyan); color: var(--text-dark)}
.home-actions .plus{font-size:18px; line-height:1}

.macro{font-size:11px; color:var(--yellow); margin-top:12px; font-weight:900}
.view{display:none}.view.active{display:block; animation: fadeIn .15s ease both}
@keyframes fadeIn{from{opacity:0} to{opacity:1}}

.sectionhead{display:flex; justify-content:space-between; align-items:center; gap:12px; margin:22px 2px 10px}
.sectionhead h2{font-size:16px; margin:0; font-weight:900; text-transform:uppercase; color: var(--cyan)}
.pill{
  border: 2px solid #000; border-radius: 99px; color: var(--text-dark); padding:3px 10px; font-size:10px;
  background: var(--yellow); font-weight:900; text-transform:uppercase; box-shadow: 2px 2px 0px #000;
}

.foodrow, .historyrow{display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px 4px; border-bottom:2px solid rgba(255,255,255,0.15)}
.foodrow:last-child, .historyrow:last-child{border-bottom:0}
.foodrow strong{display:block; font-size:13px; font-weight:900; color:#fff}
.foodrow small{display:block; color:var(--cyan); font-size:11px; margin-top:2px; font-weight:700}
.foodright{display:flex; align-items:center; gap:10px; white-space:nowrap}
.foodright b{font-size:13px; font-weight:900; color: var(--yellow)}
.iconbtn{background:transparent; border:0; color:var(--magenta); font-size:22px; padding:0 4px; font-weight:900}
.empty{color:var(--cyan); text-align:center; padding:24px 10px; font-size:12px; font-weight:900}

.actions{display:flex; gap:8px; flex-wrap:wrap; margin-top:14px}
.btn, .mainaction{
  border: var(--border); background: var(--panel); color:var(--text); border-radius:var(--radius);
  padding:12px 14px; font-weight:900; width:100%; cursor:pointer; text-transform:uppercase;
  box-shadow: var(--retro-shadow); transition: transform 0.05s; font-size:12px;
}
.btn:active, .mainaction:active{transform: translate(2px, 2px); box-shadow:none}
.btn.primary, .mainaction{background: var(--yellow); color: var(--text-dark)}
.btn.danger{background: #ff3333; color: #fff}

.historyrow{
  width:100%; background: #fff; color: var(--text-dark); border: var(--border); border-radius: var(--radius);
  text-align:left; margin:8px 0; padding:12px 14px; box-shadow: var(--retro-shadow);
}
.historyrow:active{transform: translate(2px, 2px); box-shadow:none}
.histbadge{font-size:9px; font-weight:900; border-radius:4px; padding:3px 7px; white-space:nowrap; border: 2px solid #000; text-transform:uppercase}
.histbadge.deficit{color:#000; background: var(--cyan)}
.histbadge.surplus{color:#000; background: var(--magenta)}
.histbadge.balance{color:#000; background: var(--green)}
.histdate{min-width:80px; font-size:12px; font-weight:900; color:#000}
.histnumbers{flex:1; font-size:12px; color:#333; font-weight:900}
.arrow{font-size:18px; color:#000; font-weight:900}

.field{margin:12px 0}
.field label{display:block; color:var(--cyan); font-size:10px; margin-bottom:4px; font-weight:900; text-transform:uppercase}
.field input, .field select{
  width:100%; background:#fff; border: var(--border); color:var(--text-dark);
  border-radius: 6px; padding:10px; min-height:44px; font:inherit; color-scheme:light; outline:none; font-weight:900;
}

.history-hero{
  background: var(--cyan); color: var(--text-dark); border: var(--border); border-radius: var(--radius);
  padding:20px 16px; text-align:center; margin-bottom:16px; box-shadow: 6px 6px 0px #000;
}
.history-total{font-size:clamp(32px, 8vw, 44px); font-weight:950; letter-spacing:-.04em; margin:4px 0; color:#000}
.history-total.surplus{color: var(--magenta)}
.history-average{font-size:12px; color:#000; font-weight:900}
.date-range{display:grid; grid-template-columns:1fr 1fr; gap:10px}
.date-range label{font-size:9px; color:var(--cyan); display:grid; gap:4px; font-weight:900; text-transform:uppercase}
.history-date{width:100%; border:var(--border); border-radius:6px; padding:10px; background:var(--panel); color:var(--text); font:inherit; color-scheme:dark; font-weight:900}
.history-chips{display:flex; gap:6px; flex-wrap:wrap; margin-top:12px}
.history-chips .btn{width:auto; border-radius:99px; padding:6px 12px; font-size:10px; font-weight:900; background:#fff; color:#000}

#balanceHint{
  display:block; width:100%; border-radius:var(--radius); padding:12px 14px; font-size:11px;
  line-height:1.4; text-align:left; margin:0 0 14px; background: var(--panel);
  border: var(--border); color: var(--cyan); font-weight:900;
}

.nav{
  position:fixed; z-index:20; bottom:0; left:0; right:0;
  background: var(--panel); border-top: 3px solid #000;
  padding:10px max(16px,env(safe-area-inset-left)) calc(10px + env(safe-area-inset-bottom));
  display:flex; justify-content:center; gap:8px;
  box-shadow: 0 -10px 30px rgba(0,0,0,0.5);
}
.nav button{
  flex:1; max-width:150px; border: var(--border); background: #fff;
  color: var(--text-dark); padding:8px 4px; border-radius: 6px; font-size:11px; font-weight:900;
  text-transform:uppercase; box-shadow: 2px 2px 0px #000; transition: transform 0.05s;
}
.nav button.active{background: var(--yellow); color: var(--text-dark); transform: translate(-1px, -1px); box-shadow: 3px 3px 0px #000}
.nav span{width:100%; height:20px; display:flex; align-items:center; justify-content:center; font-size:16px}

.shade{position:fixed; inset:0; background:rgba(0,0,0,0.75); z-index:30; opacity:0; pointer-events:none; transition:opacity .2s}
.shade.open{opacity:1; pointer-events:auto}
.sheet, .modal{
  position:fixed; z-index:31; left:50%; transform:translate(-50%,120%); transition:transform .2s ease;
  background: var(--panel); border: 4px solid #000; border-radius: 16px 16px 0 0;
  width:min(100%,560px); bottom:0; padding:22px 16px calc(22px + env(safe-area-inset-bottom));
  max-height:85vh; overflow:auto; box-shadow: 0 -10px 40px rgba(0,0,0,0.6);
}
.sheet.open, .modal.open{transform:translate(-50%,0)}
.sheet h2, .modal h2{margin:0 0 6px; font-size:18px; font-weight:900; text-transform:uppercase; color: var(--cyan)}
.sheet p, .modal p{color: #fff; font-size:12px; margin:0 0 16px; font-weight:700}
.choice{
  display:flex; align-items:center; gap:12px; width:100%; padding:14px; border: var(--border);
  border-radius: var(--radius); background: #fff; color: var(--text-dark); text-align:left; margin-top:8px;
  box-shadow: var(--retro-shadow); transition: transform 0.05s;
}
.choice:active{transform: translate(2px, 2px); box-shadow:none}
.choice .emoji{width:40px; height:40px; border-radius: 6px; background: var(--yellow); border: 2px solid #000; display:grid; place-items:center; font-size:20px}
.choice strong{display:block; font-size:13px; font-weight:900; text-transform:uppercase; color:#000}
.choice small{color:#444; font-size:11px; font-weight:700}

.search{width:100%; background:#fff; border: var(--border); border-radius: 6px; color:var(--text-dark); padding:12px; margin:10px 0; outline:none; font-weight:900}
.suggestion{display:flex; justify-content:space-between; align-items:center; width:100%; border:0; border-bottom:2px solid rgba(255,255,255,0.2); background:transparent; color:#fff; padding:12px 4px; text-align:left}
.suggestion b{font-size:12px; color:var(--yellow)}
.closebar{display:flex; justify-content:space-between; align-items:center}
.closebar button{border: var(--border); background: var(--magenta); width:32px; height:32px; border-radius:50%; color:#fff; font-size:18px; font-weight:900; display:grid; place-items:center; box-shadow: 2px 2px 0px #000}

.foot{font-size:10px; color:var(--cyan); text-align:center; margin-top:22px; font-weight:900; text-transform:uppercase}
.hidden{display:none!important}
.toast{
  position:fixed; z-index:50; bottom:90px; left:50%; transform:translate(-50%,15px);
  opacity:0; pointer-events:none; background: var(--yellow); color: var(--text-dark); font-weight:900;
  padding:10px 16px; border-radius: var(--radius); border: var(--border); box-shadow: var(--retro-shadow);
  transition:.15s; font-size:12px; text-transform:uppercase;
}
.toast.visible{opacity:1; transform:translate(-50%,0)}
.tefbox{background:#fff; color:var(--text-dark); border: var(--border); border-radius:6px; padding:12px; margin-top:12px; font-size:11px; font-weight:900}
.tefbox strong{color:var(--magenta); display:block; margin-bottom:2px; font-weight:900; text-transform:uppercase}
</style>
</head>
<body>
<main>
<header class="top">
  <div><div class="brand">● 80S AEROBIC</div><h1>Il tuo equilibrio</h1></div>
  <div class="dateinput-wrap"><input class="dateinput" id="day" type="date" aria-label="Seleziona giornata"></div>
</header>

<!-- 1. HOME — SOLO MONITORAGGIO GIORNALIERO -->
<section class="view active" id="view-home">
<section class="steps-top" aria-label="Attività giornaliera">
  <div><label for="homeSteps">I tuoi passi oggi</label><div class="hint" id="activityLevel">Stima del consumo da camminata</div></div>
  <div class="steps-input"><input id="homeSteps" type="number" min="0" max="100000" step="1" inputmode="numeric" placeholder="0" aria-label="Totale passi giornalieri"><span>passi</span></div>
</section>

<div class="card hero"><div class="herotop"><div><div class="eyebrow">Entrata · Uscita</div><div class="daylabel" id="dayLabelSub">Il tuo bilancio energetico</div></div><span class="pill" id="dayStatusPill">OFFLINE</span></div>
<div class="balance-visual">
<div class="balance-caption">Saldo Energetico Reale</div>
<div class="balance-delta" id="balanceDelta">0 kcal</div>
<div class="balance-sub" id="balanceSub">Assunte meno spesa energetica totale (TDEE)</div>
<div class="balance-poles">
<div class="balance-pole"><small>Assunte</small><strong id="intake">0</strong></div>
<div class="balance-vs">VS</div>
<div class="balance-pole"><small>TDEE Spesa</small><strong id="burnNum">—</strong></div>
</div>
<div class="balance-track" aria-label="Saldo energetico rispetto allo zero"><span class="balance-marker" id="balanceMarker"></span></div>
<div class="balance-scale"><span>Deficit</span><span>Equilibrio 0</span><span>Surplus</span></div>
</div>
<div class="numbers">
<div class="numcard"><div class="numlabel">Target giornaliero</div><div class="numvalue" id="targetNum">— <small>kcal</small></div></div>
<div class="numcard"><div class="numlabel" id="remainingLabel">kcal al target</div><div class="numvalue remaining" id="remaining">2.000</div><div class="hint">rispetto al target</div></div>
<div class="numcard"><div class="numlabel">TEF stimato</div><div class="numvalue" id="tefNum">— <small>kcal</small></div></div>
</div>
<div class="home-actions"><button class="food-action" id="addFoodHome"><span class="plus">＋</span> Aggiungi cibo</button><button class="activity-action" id="addActivityHome"><span class="plus">＋</span> Aggiungi attività</button></div>
<div class="macro" id="macro">Macro facoltativi · nessun dato inserito</div>
</div>

