document.querySelectorAll('[data-history-range]').forEach(btn=>btn.onclick=()=>{const range=btn.dataset.historyRange;if(range==='all'){$('historyFrom').value='';$('historyTo').value='';}else{const end=new Date(),start=new Date();start.setDate(start.getDate()-Number(range)+1);const iso=d=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;$('historyFrom').value=iso(start);$('historyTo').value=iso(end);}renderHistory()});

$('export').onclick=async()=>{
 try{
  if(!persist())return;const json=JSON.stringify(db,null,2);const filename='backup-bilancio-calorico-v5.19.json';
  if(navigator.share&&navigator.canShare){try{const file=new File([json],filename,{type:'application/json'});if(navigator.canShare({files:[file]})){await navigator.share({files:[file],title:'Backup Bilancio Calorico'});toast('Backup condiviso');return;}}catch(_){}}
  const blob=new Blob([json],{type:'application/json;charset=utf-8'});let url='';try{url=URL.createObjectURL(blob)}catch(_){}
  const a=document.createElement('a');a.href=url||`data:application/json;charset=utf-8,${encodeURIComponent(json)}`;a.download=filename;a.rel='noopener';a.style.display='none';
  document.body.appendChild(a);a.click();a.remove();if(url)setTimeout(()=>URL.revokeObjectURL(url),30000);toast('Esportazione avviata');
 }catch(err){if(err&&err.name==='AbortError'){toast('Annullato');return;}alert('Errore esportazione');}
};

$('importBtn').onclick=()=>$('importFile').click();
$('importFile').onchange=async e=>{
 const file=e.target.files[0];
 if(!file) return;
 try{
  const imported=upgrade(JSON.parse(await file.text()));
  if(!confirm('Importare backup? I dati attuali saranno sostituiti.'))return;
  const previous=db;db=imported;
  if(!db.days[activeDay]) db.days[activeDay]=blank();
  if(!persist()){db=previous;render();return;}
  render();
  toast('Backup importato');
 }catch(err){
  alert('Backup non valido: '+err.message);
 }finally{
  $('importFile').value='';
 }
};

render();if(loadSafeToPersist)persist();
})();
