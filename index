$('stepsForm').addEventListener('submit',e=>{e.preventDefault();const total=parseValidNumber($('stepsTotal').value,0,100000);if(!Number.isFinite(total))return;const d=current();if(!dayEditable(d))return;const previous=d.totalSteps;d.totalSteps=String(Math.round(total));if(!persist()){d.totalSteps=previous;return;}$('homeSteps').value=d.totalSteps;closeAllModals();render();toast('Passi registrati')});
$('activityForm').addEventListener('submit',e=>{e.preventDefault();const kcal=parseValidNumber($('activityKcal').value,1,5000);if(!Number.isFinite(kcal))return;const d=current();if(!dayEditable(d))return;if(!Array.isArray(d.activities))d.activities=[];d.activities.push({id:`act_${Date.now()}_${Math.random().toString(36).slice(2,7)}`,name:$('activityName').value.trim()||'Attività',kcal:Math.round(kcal)});d.workoutKcal=d.activities.reduce((sum,a)=>sum+val(a.kcal),0);if(!persist()){d.activities.pop();d.workoutKcal=d.activities.reduce((sum,a)=>sum+val(a.kcal),0);return;}closeAllModals();render();toast('Movimento registrato')});

$('saveDay').onclick=()=>{
 const d=current();const bmr=bmrEstimate(),steps=stepExtra(d).kcal,ti=tefInfo(d);
 if(!Number.isFinite(bmr)||!Number.isFinite(steps)){alert('Impossibile salvare: dati non validi.');return;}
 const previous={saved:d.saved,bmrSnapshot:d.bmrSnapshot,tdeeSnapshot:d.tdeeSnapshot};
 d.bmrSnapshot=bmr;d.tdeeSnapshot=bmr+steps+activityKcal(d)+ti.usableKcal;d.saved=true;
