<script>
(()=>{
'use strict';
const $=id=>document.getElementById(id), STORE='bilancioCaloricoApp_v1';
const today=()=>{const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`};
const fmt=x=>Math.round(Number(x)||0).toString();
const num=v=>{const x=Number(v);return Number.isFinite(x)&&x>0?x:0};
const val=(v,f=0)=>v!==undefined&&v!==null&&v!==''&&Number.isFinite(Number(v))?Number(v):f;
const defaults={version:5.19,pantry:[],days:{},settings:{target:null,targetEdited:false,gender:'male',age:30,weight:70,height:175,activity:1.2}};
let db=structuredClone(defaults), activeDay=today(), historyFilter=30, selectedFood=null, loadSafeToPersist=true;
const foods=[
{name:'Mela',k:52,c:14,p:.3,f:.2},{name:'Banana',k:89,c:23,p:1.1,f:.3},{name:'Yogurt greco 0%',k:59,c:3.6,p:10,f:0},{name:'Uova intere',k:155,c:1.1,p:13,f:11},{name:'Petto di pollo',k:165,c:0,p:31,f:3.6},{name:'Riso crudo',k:360,c:79,p:7,f:.6},{name:'Pasta secca',k:355,c:72,p:12,f:1.5},{name:'Pane comune',k:265,c:49,p:9,f:3.2},{name:'Pizza margherita',k:271,c:33,p:10,f:10},{name:'Tonno al naturale',k:116,c:0,p:26,f:1},{name:'Lenticchie cotte',k:116,c:20,p:9,f:.4},{name:'Salmone',k:208,c:0,p:20,f:13},{name:'Pesce spada',k:144,c:0,p:20,f:6},{name:'Biscotti integrali',k:436,c:75,p:8.7,f:10},{name:'Fiocchi d’avena',k:372,c:58,p:13.5,f:7},{name:'Olio extravergine d’oliva',k:884,c:0,p:0,f:100},{name:'Proteine in polvere',k:400,c:8,p:80,f:6},{name:'Cioccolato fondente',k:575,c:46,p:8,f:42}
];
function blank(){return {version:5.19, saved:false, foods:[], activities:[], totalSteps:'', workoutKcal:0, bmrSnapshot:null, tdeeSnapshot:null}}
function safeNumber(value,fallback=0){if(value===null||value===undefined||(typeof value==='string'&&value.trim()===''))return fallback;const n=Number(value);return Number.isFinite(n)?n:fallback;}
function parseValidNumber(value,min,max,{allowBlank=false}={}){if(value===null||value===undefined||(typeof value==='string'&&value.trim()===''))return allowBlank?null:NaN;const n=Number(value);return Number.isFinite(n)&&n>=min&&n<=max?n:NaN;}
function validSnapshot(v,min=1,max=50000){return typeof v==='number'&&Number.isFinite(v)&&v>=min&&v<=max}

function upgrade(raw){
 if(!raw||typeof raw!=='object'||Array.isArray(raw))throw Error('Backup non valido');
 const sourceDays=raw.days&&typeof raw.days==='object'&&!Array.isArray(raw.days)?raw.days:(raw.data?.days&&typeof raw.data.days==='object'&&!Array.isArray(raw.data.days)?raw.data.days:null);
 if(!sourceDays)throw Error('Backup non valido: manca lo storico');
 const s=raw.settings&&typeof raw.settings==='object'&&!Array.isArray(raw.settings)?raw.settings:{};
 const version=Number(raw.version)||0, legacy=version<5.13;
 const field=(value,min,max,fallback,label)=>{if(value===undefined||value===null||value==='') {if(legacy)return fallback;throw Error(`Backup non valido: manca ${label}`)} const n=parseValidNumber(value,min,max);if(!Number.isFinite(n))throw Error(`Backup non valido: ${label} fuori intervallo`);return n;};
 const targetRaw=s.targetKcal??s.target;
 const target=targetRaw===undefined||targetRaw===null||targetRaw===''?null:field(targetRaw,500,10000,null,'obiettivo');
 const out={version:5.19,pantry:[],settings:{...defaults.settings,...s,age:field(s.age,13,110,30,'età'),weight:field(s.weight,25,350,70,'peso'),height:field(s.height,100,250,175,'altezza'),target,targetEdited:typeof s.targetEdited==='boolean'?s.targetEdited:(target!==null&&target!==2000),gender:s.gender==='female'?'female':'male'},days:{}};
 const pantry=Array.isArray(raw.pantry)?raw.pantry:[];
 out.pantry=pantry.filter(x=>x&&typeof x==='object'&&!Array.isArray(x)).map((f,i)=>({name:String(f.name||`Alimento ${i+1}`),k:field(f.k,1,1000,1,`calorie Dispensa ${i+1}`),c:parseValidNumber(f.c,0,2000,{allowBlank:true}),p:parseValidNumber(f.p,0,2000,{allowBlank:true}),f:parseValidNumber(f.f,0,2000,{allowBlank:true})})).map(f=>({...f,c:f.c===null?'':f.c,p:f.p===null?'':f.p,f:f.f===null?'':f.f}));
 for(const [date,o] of Object.entries(sourceDays)){
  if(!/^\d{4}-\d{2}-\d{2}$/.test(date)||!o||typeof o!=='object'||Array.isArray(o))continue;
  const sourceFoods=Array.isArray(o.foods)?o.foods:[];
  const dayFoods=sourceFoods.filter(f=>f&&typeof f==='object'&&!Array.isArray(f)).map((f,i)=>{
   const k=parseValidNumber(f.k??f.kcal,0,15000);if(!Number.isFinite(k))throw Error(`Backup non valido: calorie alimento ${i+1} (${date})`);
   const macro=x=>{const n=parseValidNumber(x,0,2000,{allowBlank:true});if(Number.isNaN(n))throw Error(`Backup non valido: macro alimento ${i+1} (${date})`);return n===null?'':n};
   return {id:String(f.id||`${date}_${i}`),name:String(f.name||'Alimento'),k,c:macro(f.c),p:macro(f.p),f:macro(f.f),qty:f.qty??''};
  });
  const sourceActivities=Array.isArray(o.activities)?o.activities:[];
  const activities=sourceActivities.filter(a=>a&&typeof a==='object'&&!Array.isArray(a)).map((a,i)=>({id:String(a.id||`${date}_act_${i}`),name:String(a.name||a.label||'Attività'),kcal:field(a.kcal??a.calories,0,5000,0,`attività ${date}`)}));
  const legacyWorkout=parseValidNumber(o.workoutKcal??o.burn?.workoutKcal,0,30000);
  if(!activities.length&&Number.isFinite(legacyWorkout)&&legacyWorkout>0)activities.push({id:`${date}_legacy_activity`,name:'Attività precedente',kcal:legacyWorkout});
  const rawSteps=o.totalSteps??o.steps??o.burn?.totalSteps??'';
  const steps=rawSteps===''||rawSteps===null||rawSteps===undefined?'':parseValidNumber(rawSteps,0,100000);
  if(steps!==''&&!Number.isFinite(steps))throw Error(`Backup non valido: passi (${date})`);
  const saved=o.saved===true;
  const bmrSnapshot=validSnapshot(o.bmrSnapshot,500,5000)?o.bmrSnapshot:null;
  const tdeeSnapshot=validSnapshot(o.tdeeSnapshot,500,50000)?o.tdeeSnapshot:null;
  out.days[date]={...blank(),...o,version:5.19,saved,foods:dayFoods,activities,totalSteps:steps===''?'':String(Math.round(steps)),workoutKcal:activities.reduce((sum,a)=>sum+a.kcal,0),bmrSnapshot,tdeeSnapshot};
 }
 return out;
}

function load(){
 try{
  const raw=localStorage.getItem(STORE);
  if(raw) db=upgrade(JSON.parse(raw));
 }catch(e){
  console.warn('Caricamento dati non riuscito, uso stato di default protetto:', e);
 }
}

function persist(){
 if(!loadSafeToPersist){console.warn('Salvataggio bloccato per proteggere dati locali non leggibili.');return false;}
 try{
  db.version=5.19;
  if(!db.settings||typeof db.settings!=='object'||Array.isArray(db.settings))db.settings={...defaults.settings};
  db.settings.targetKcal=db.settings.target;
  db.settings.activity=1.2;
  if(!db.days||typeof db.days!=='object'||Array.isArray(db.days))db.days={};
  for(const d of Object.values(db.days)){
   if(!d||typeof d!=='object'||Array.isArray(d))continue;
   d.activities=Array.isArray(d.activities)?d.activities.filter(a=>a&&typeof a==='object').map((a,i)=>({id:String(a.id||`act_${i}`),name:String(a.name||'Attività'),kcal:Math.max(0,safeNumber(a.kcal,0))})):[];
   const activityTotal=d.activities.reduce((sum,a)=>sum+a.kcal,0);
   d.workoutKcal=d.activities.length?activityTotal:Math.max(0,safeNumber(d.workoutKcal,0));
   const steps=d.totalSteps;
   d.totalSteps=steps===''||steps===null||steps===undefined?'':String(Math.max(0,Math.min(100000,Math.round(safeNumber(steps,0)))));
   d.version=5.19;
  }
  localStorage.setItem(STORE,JSON.stringify(db));
  return true;
 }catch(e){
  console.error('Salvataggio locale fallito:', e);
  alert('Attenzione: impossibile salvare i dati localmente (memoria piena o bloccata).');
  return false;
 }
}

function current(){if(!db.days[activeDay])db.days[activeDay]=blank();return db.days[activeDay]}
function macro0(v){return v===''||v===null||v===undefined?0:Math.max(0,val(v,0))}
function totals(d=current()){return d.foods.reduce((a,f)=>({k:a.k+macro0(f.k),c:a.c+macro0(f.c),p:a.p+macro0(f.p),f:a.f+macro0(f.f)}),{k:0,c:0,p:0,f:0});}

function tefInfo(d=current()){
 let kcal=0,known=0,complete=true,fieldCount=0;
 const fields=[['c',4*0.075],['p',4*0.225],['f',9*0.025]];
 for(const food of (d.foods||[])){
  for(const [key,rate] of fields){
   fieldCount++;
   const raw=food[key];
   if(raw!==''&&raw!==null&&raw!==undefined&&!(typeof raw==='string'&&raw.trim()==='')&&Number.isFinite(Number(raw))&&Number(raw)>=0){
    kcal+=Number(raw)*rate;
    known++;
   } else {
    complete=false;
   }
  }
 }
 const isComplete=fieldCount===0||complete;
 return {kcal, usableKcal:kcal, known, complete:isComplete, any:known>0, fieldCount};
}
function tef(d=current()){return tefInfo(d).usableKcal;}

function bmrEstimate(){
 const age=parseValidNumber($('age').value,13,110),w=parseValidNumber($('weight').value,25,350),h=parseValidNumber($('height').value,100,250),gender=$('gender').value;
 if(!Number.isFinite(age)||!Number.isFinite(w)||!Number.isFinite(h)||!['male','female'].includes(gender))return null;
 return 10*w+6.25*h-5*age+(gender==='male'?5:-161);
}
function activityBand(total){const steps=Math.max(0,safeNumber(total,0));let label='Bassa · pochi passi';if(steps>=10000)label='Alta · giornata molto attiva';else if(steps>=7000)label='Moderata · giornata attiva';else if(steps>=3500)label='Leggera · movimento quotidiano';return {label};}
function stepExtra(d=current(),totalOverride){
 const raw=totalOverride===undefined?d.totalSteps:totalOverride,total=raw===''||raw===null||raw===undefined?0:parseValidNumber(raw,0,100000),weight=parseValidNumber($('weight').value,25,350);
 if(!Number.isFinite(total)||!Number.isFinite(weight))return {total:0,extra:0,kcal:null,band:activityBand(0)};
 const band=activityBand(total),kcal=total*weight*0.00035;
 return {total,extra:total,kcal,band}
}
function activityKcal(d=current()){if(Array.isArray(d.activities)&&d.activities.length)return d.activities.reduce((sum,a)=>sum+Math.max(0,safeNumber(a?.kcal,0)),0);return Math.max(0,safeNumber(d.workoutKcal,0))}

function activeBmr(d=current()){if(d.saved)return validSnapshot(d.bmrSnapshot,500,5000)?d.bmrSnapshot:null;return bmrEstimate();}
function expenditure(d=current()){if(d.saved)return validSnapshot(d.tdeeSnapshot,500,50000)?d.tdeeSnapshot:null;const bmr=activeBmr(d),steps=stepExtra(d).kcal,ti=tefInfo(d);if(!Number.isFinite(bmr)||!Number.isFinite(steps))return null;return bmr+steps+activityKcal(d)+ti.usableKcal;}
function dayEditable(d=current()){if(!d.saved)return true;if(!confirm('Questa giornata è salvata nello storico. Vuoi sbloccarla e modificarla?'))return false;d.saved=false;d.bmrSnapshot=null;d.tdeeSnapshot=null;persist();return true;}
function saveProfile(){
 const age=parseValidNumber($('age').value,13,110),weight=parseValidNumber($('weight').value,25,350),height=parseValidNumber($('height').value,100,250),target=parseValidNumber($('target').value,500,10000);
 if(![age,weight,height,target].every(Number.isFinite)){alert('Controlla età (13-110), peso (25-350 kg), altezza e obiettivo.');return false;}
 db.settings={...db.settings,age,weight,height,gender:$('gender').value,target,targetEdited:true};
 if(persist()) { render(); return true; }
 return false;
}

function renderFoods(){
 const box=$('foodList');box.replaceChildren();const d=current(),fs=d.foods||[],acts=d.activities||[];
 if(!fs.length&&!acts.length){box.innerHTML='<div class="empty">Nessun alimento o movimento aggiunto per oggi.</div>';return;}
 fs.forEach((f,i)=>{
  const row=document.createElement('div');row.className='foodrow';
  const left=document.createElement('div');const strong=document.createElement('strong');strong.textContent=f.name+(f.qty?` (${f.qty} g)`: '');
  const small=document.createElement('small');const macros=[];if(f.c!==''&&f.c!=null)macros.push(`C ${macro0(f.c)} g`);if(f.p!==''&&f.p!=null)macros.push(`P ${macro0(f.p)} g`);if(f.f!==''&&f.f!=null)macros.push(`G ${macro0(f.f)} g`);small.textContent=macros.join(' · ')||'Calorie dirette';left.append(strong,small);
  const right=document.createElement('div');right.className='foodright';const kcal=document.createElement('b');kcal.textContent=`${fmt(f.k)} kcal`;
  const del=document.createElement('button');del.className='iconbtn';del.textContent='×';del.onclick=()=>{const day=current();if(!dayEditable(day))return;day.foods.splice(i,1);persist();render()};
  right.append(kcal,del);row.append(left,right);box.append(row);
 });
 acts.forEach((i,a)=>{
  const row=document.createElement('div');row.className='foodrow';
  const left=document.createElement('div');const strong=document.createElement('strong');strong.textContent='🏃 '+a.name;const small=document.createElement('small');small.textContent='Attività fisica · calorie attive';left.append(strong,small);
  const right=document.createElement('div');right.className='foodright';const kcal=document.createElement('b');kcal.textContent=`−${fmt(a.kcal)} kcal`;kcal.style.color='var(--green)';
  const del=document.createElement('button');del.className='iconbtn';del.textContent='×';del.onclick=()=>{const day=current();if(!dayEditable(day))return;day.activities.splice(i,1);day.workoutKcal=day.activities.reduce((sum,item)=>sum+val(item.kcal),0);persist();render()};
  right.append(kcal,del);row.append(left,right);box.append(row);
 });
}
function renderPantry(){
 const box=$('pantryList');box.replaceChildren();if(!db.pantry.length){box.innerHTML='<div class="empty">La Dispensa è vuota. Aggiungi i tuoi alimenti abituali.</div>';return;}
 db.pantry.forEach((f,i)=>{
  const row=document.createElement('div');row.className='foodrow';const left=document.createElement('div');const name=document.createElement('strong');name.textContent=f.name;const sub=document.createElement('small');sub.textContent=`C ${f.c||0} g · P ${f.p||0} g · G ${f.f||0} g per 100 g`;left.append(name,sub);
  const right=document.createElement('div');right.className='foodright';const k=document.createElement('b');k.textContent=`${f.k} kcal`;
  const del=document.createElement('button');del.className='iconbtn';del.textContent='×';del.onclick=()=>{if(!confirm('Eliminare questo alimento dalla Dispensa?'))return;db.pantry.splice(i,1);persist();renderPantry()};
  right.append(k,del);row.append(left,right);box.append(row);
 });
}
function renderHistory(){
 const box=$('historyList');box.replaceChildren();
 const from=$('historyFrom').value,to=$('historyTo').value;
 const keys=Object.keys(db.days).filter(k=>db.days[k].saved&&(!from||k>=from)&&(!to||k<=to)).sort().reverse();
 let total=0,count=0;keys.forEach(k=>{const d=db.days[k],intake=totals(d).k,tdee=validSnapshot(d.tdeeSnapshot,500,50000)?Number(d.tdeeSnapshot):null;if(tdee!==null){total+=intake-tdee;count++}});
 const totalEl=$('historyTotal');totalEl.textContent=count?`${total>0?'+':total<0?'−':'±'}${fmt(Math.abs(total))} kcal`:'— kcal';totalEl.classList.toggle('surplus',total>0);
 $('historyAverage').textContent=count?`Media giornaliera: ${total/count>0?'+':total/count<0?'−':'±'}${fmt(Math.abs(total/count))} kcal/giorno su ${count} giorni`:'Nessun saldo calcolabile nel periodo';
 $('historyEmpty').classList.toggle('hidden',keys.length>0);
 keys.forEach(k=>{
  const d=db.days[k],intake=totals(d).k,tdee=validSnapshot(d.tdeeSnapshot,500,5000)?Number(d.tdeeSnapshot):null,delta=tdee===null?null:intake-tdee;
  const row=document.createElement('button');row.className='historyrow';
  const date=document.createElement('span');date.className='histdate';date.textContent=new Date(k+'T12:00:00').toLocaleDateString('it-IT',{day:'2-digit',month:'short',year:'numeric'});
  const numbers=document.createElement('span');numbers.className='histnumbers';numbers.textContent=`Assunte ${fmt(intake)} · TDEE ${tdee===null?'—':fmt(tdee)}`;
  const badge=document.createElement('span');badge.className='histbadge '+(delta===null?'balance':delta<0?'deficit':delta>0?'surplus':'balance');badge.textContent=delta===null?'N/D':delta<0?'Deficit':delta>0?'Surplus':'Equilibrio';
  const arrow=document.createElement('span');arrow.className='arrow';arrow.textContent='›';
  row.append(date,numbers,badge,arrow);row.onclick=()=>{activeDay=k;showView('home');render()};box.append(row);
 });
}

function render(){
 const d=current(),t=totals(d),tdee=expenditure(d),target=parseValidNumber($('target').value,500,10000),activity=activityKcal(d),steps=stepExtra(d),ti=tefInfo(d);
 const bmr=activeBmr(d),validEnergy=Number.isFinite(tdee)&&Number.isFinite(bmr)&&Number.isFinite(target);
 $('bmrDisplay').textContent=Number.isFinite(bmr)?fmt(bmr):'—';
 const delta=validEnergy?t.k-tdee:null, remaining=Number.isFinite(target)?target-t.k:null;
 $('intake').textContent=fmt(t.k);
 $('burnNum').textContent=Number.isFinite(tdee)?fmt(tdee):'—';
 $('targetNum').innerHTML=`${Number.isFinite(target)?fmt(target):'—'} <small>kcal</small>`;
 $('remaining').textContent=remaining===null?'—':remaining>=0?fmt(remaining):`+${fmt(-remaining)}`;
 $('remainingLabel').textContent=remaining===null?'obiettivo non valido':remaining>=0?'kcal al target':'kcal oltre target';
 const deltaEl=$('balanceDelta');
 deltaEl.textContent=delta===null?'Bilancio non disponibile':`${delta>0?'+':delta<0?'−':'±'}${fmt(Math.abs(delta))} kcal`;
 deltaEl.classList.toggle('deficit',delta!==null&&delta<0);
 deltaEl.classList.toggle('surplus',delta!==null&&delta>0);
 $('balanceSub').textContent=delta===null?'Snapshot o dati energetici mancanti':delta===0?'Assunzione pari alla spesa TDEE':delta<0?'Deficit calorico reale':'Surplus calorico reale';
 const marker=$('balanceMarker'),offset=delta===null?0:Math.max(-48,Math.min(48,delta/Math.max(1,Math.max(t.k,tdee,1000))*48));
 marker.style.left=`${50+offset}%`;
 marker.classList.toggle('deficit',delta<0);
 marker.classList.toggle('surplus',delta>0);
 $('tefNum').innerHTML=`${fmt(ti.kcal)} <small>kcal</small>`;
 $('balanceNum').textContent=delta===null?'—':`${delta>0?'+':delta<0?'−':'±'}${fmt(Math.abs(delta))} kcal`;
 $('balanceHint').textContent=`BMR (${Number.isFinite(bmr)?fmt(bmr):'—'}) + passi (${Number.isFinite(steps.kcal)?fmt(steps.kcal):'—'}) + allenamento (${fmt(activity)}) + TEF (${ti.complete?fmt(ti.usableKcal):'parziale'}).`;
 $('macro').textContent=`C ${fmt(t.c)} g · P ${fmt(t.p)} g · G ${fmt(t.f)} g · Passi ${fmt(steps.total)}`;
 $('activityLevel').textContent=`${steps.band.label} · ${Number.isFinite(steps.kcal)?'circa '+fmt(steps.kcal)+' kcal':'stima n/d'}`;
 const homeSteps=$('homeSteps');if(document.activeElement!==homeSteps)homeSteps.value=d.totalSteps||'';
 $('day').value=activeDay;
 const dateObj=new Date(activeDay+'T12:00:00');
 $('dayLabelSub').textContent=dateObj.toLocaleDateString('it-IT',{weekday:'long',day:'numeric',month:'long'});
 $('dayStatusPill').textContent = d.saved ? 'SALVATO' : 'OFFLINE';
 renderFoods();renderHistory();renderPantry();
}

function toast(s){$('toast').textContent=s;$('toast').classList.add('visible');setTimeout(()=>$('toast').classList.remove('visible'),1600)}
function openAction(){$('actionSheet').classList.add('open');$('sheetShade').classList.add('open')}
function closeAction(){$('actionSheet').classList.remove('open');$('sheetShade').classList.remove('open')}
function openModal(id){closeAllModals();$(id).classList.add('open');$('modalShade').classList.add('open')}
function toggleInfo(infoId,buttonId){const info=$(infoId),button=$(buttonId),opening=info.classList.contains('hidden');info.classList.toggle('hidden');button.setAttribute('aria-expanded',String(opening));}
function closeAllModals(){['foodModal','quantityModal','pantryAddModal','genericModal','activityModal','stepsModal'].forEach(id=>$(id).classList.remove('open'));$('modalShade').classList.remove('open')}
function showView(v){document.querySelectorAll('.view').forEach(el=>el.classList.toggle('active',el.id===`view-${v}`));document.querySelectorAll('[data-view]').forEach(el=>el.classList.toggle('active',el.dataset.view===v));if(v==='history')renderHistory();if(v==='pantry')renderPantry();if(v==='home')renderFoods()}

function renderFoodChoices(){
 const q=$('foodSearch').value.toLowerCase().trim(),box=$('foodChoices');box.replaceChildren();
 const all=[...db.pantry.map(f=>({...f,source:'🏪'})),...foods.map(f=>({...f,source:''}))];
 all.filter(f=>f.name.toLowerCase().includes(q)).forEach(f=>{
  const b=document.createElement('button');b.className='suggestion';
  const span=document.createElement('span');const strong=document.createElement('strong');strong.textContent=(f.source?f.source+' ':'')+f.name;
  const small=document.createElement('small');small.textContent=` · 100g`;span.append(strong,small);
  const kcal=document.createElement('b');kcal.textContent=`${f.k} kcal`;b.append(span,kcal);
  b.onclick=()=>{selectedFood=f;closeAllModals();$('quantTitle').textContent=f.name;$('quantSub').textContent=`${f.k} kcal per 100 g.`;$('quantInput').value='100';openModal('quantityModal');$('quantInput').focus()};
  box.append(b);
 });
 if(!box.children.length)box.innerHTML='<div class="empty">Nessun risultato. Puoi usare Cibo generico.</div>';
}

load();if(!db.days[activeDay])db.days[activeDay]=blank();
$('age').value=Number.isFinite(Number(db.settings.age))?db.settings.age:30;$('weight').value=Number.isFinite(Number(db.settings.weight))?db.settings.weight:70;$('height').value=Number.isFinite(Number(db.settings.height))?db.settings.height:175;$('gender').value=db.settings.gender==='female'?'female':'male';
$('target').value=(db.settings.targetEdited&&Number.isFinite(Number(db.settings.target))&&Number(db.settings.target)>=500&&Number(db.settings.target)<=10000)?db.settings.target:2000;db.settings.target=Number($('target').value);let lastValidTarget=Number($('target').value);

['age','weight','height','gender'].forEach(id=>$(id).addEventListener('input',()=>{const age=parseValidNumber($('age').value,13,110),weight=parseValidNumber($('weight').value,25,350),height=parseValidNumber($('height').value,100,250);if(![age,weight,height].every(Number.isFinite))return;db.settings={...db.settings,age,weight,height,gender:$('gender').value};persist();render()}));
document.querySelectorAll('[data-step]').forEach(button=>button.addEventListener('click',()=>{
 const id=button.dataset.step,input=$(id),delta=Number(button.dataset.delta),min=Number(input.min),max=Number(input.max),step=id==='weight'?0.5:1;
 let value=Number(input.value);if(!Number.isFinite(value)||value===0)value=id==='weight'?Number($('weight').value):id==='age'?Number($('age').value):Number($('height').value);
 value=Math.min(max,Math.max(min,Math.round((value+delta)/step)*step));
 input.value=id==='weight'?value.toFixed(1):String(value);
 input.dispatchEvent(new Event('input',{bubbles:true}));
}));

function validateTargetInput({restore=false}={}){
 const input=$('target'),target=parseValidNumber(input.value,500,10000),valid=Number.isFinite(target);
 input.setAttribute('aria-invalid',String(!valid));
 $('targetValidation').classList.toggle('hidden',valid);
 if(!valid){if(restore){input.value=String(lastValidTarget);input.setAttribute('aria-invalid','false');$('targetValidation').classList.add('hidden');render();}else render();return false;}
 lastValidTarget=target;db.settings.target=target;db.settings.targetEdited=true;persist();render();return true;
}
$('target').addEventListener('input',()=>validateTargetInput());
$('target').addEventListener('change',()=>validateTargetInput());
$('target').addEventListener('blur',()=>{if(!validateTargetInput())validateTargetInput({restore:true})});
$('day').addEventListener('change',()=>{if($('day').value){activeDay=$('day').value;render()}});
$('homeSteps').addEventListener('input',()=>{
 const d=current();if(d.saved){$('homeSteps').value=d.totalSteps||'';return;}
 const raw=parseValidNumber($('homeSteps').value,0,100000,{allowBlank:true});
 if(raw===null && $('homeSteps').value.trim()!=='')return;
 const previous=d.totalSteps;d.totalSteps=raw===null?'':String(Math.round(raw));
 if(!persist()){d.totalSteps=previous;$('homeSteps').value=previous||'';}
