$('chooseActivity').onclick=()=>{closeAction();const d=current();if(!dayEditable(d))return;openModal('activityModal');$('activityKcal').value='';$('activityName').value=''};
$('chooseSteps').onclick=()=>{closeAction();const d=current();if(!dayEditable(d))return;$('stepsTotal').value=current().totalSteps||'';updateStepsPreview();openModal('stepsModal')};
$('closeSteps').onclick=()=>{closeAllModals();render()};$('modalShade').addEventListener('click',()=>render());$('foodSearch').addEventListener('input',renderFoodChoices);
$('closeFood').onclick=closeAllModals;$('closeQuantity').onclick=closeAllModals;$('closePantry').onclick=closeAllModals;$('closeGeneric').onclick=closeAllModals;$('closeActivity').onclick=closeAllModals;
$('genericOpen').onclick=()=>{openModal('genericModal');$('genericName').focus()};$('openAddPantry').onclick=()=>{openModal('pantryAddModal');$('pantryName').focus()};

$('quantityForm').addEventListener('submit',e=>{e.preventDefault();const grams=parseValidNumber($('quantInput').value,1,5000);if(!selectedFood||!Number.isFinite(grams))return;const d=current();if(!dayEditable(d))return;const r=grams/100;d.foods.push({name:selectedFood.name,qty:grams,k:Math.round(selectedFood.k*r),c:selectedFood.c!==''?Math.round(num(selectedFood.c)*r*10)/10:'',p:selectedFood.p!==''?Math.round(num(selectedFood.p)*r*10)/10:'',f:selectedFood.f!==''?Math.round(num(selectedFood.f)*r*10)/10:''});if(!persist()){d.foods.pop();return;}closeAllModals();render();toast('Cibo aggiunto')});
$('genericForm').addEventListener('submit',e=>{e.preventDefault();const name=$('genericName').value.trim(),k=parseValidNumber($('genericKcal').value,1,15000);if(!name||!Number.isFinite(k))return;const macroValue=id=>{const raw=$(id).value;if(raw.trim()==='')return '';const n=parseValidNumber(raw,0,2000);return Number.isFinite(n)?n:NaN};const macros=[macroValue('genericC'),macroValue('genericP'),macroValue('genericF')];if(macros.some(Number.isNaN)){alert('Controlla i macro.');return;}const d=current();if(!dayEditable(d))return;d.foods.push({name,k,c:macros[0],p:macros[1],f:macros[2]});if(!persist()){d.foods.pop();return;}$('genericForm').reset();closeAllModals();render();toast('Cibo aggiunto')});
$('pantryForm').addEventListener('submit',e=>{e.preventDefault();const name=$('pantryName').value.trim(),k=parseValidNumber($('pantryKcal').value,1,1000),macro=id=>{const raw=$(id).value;if(raw.trim()==='')return '';const n=parseValidNumber(raw,0,2000);return Number.isFinite(n)?n:NaN;},c=macro('pantryC'),pr=macro('pantryP'),f=macro('pantryF');if(!name||!Number.isFinite(k)||[c,pr,f].some(Number.isNaN)){alert('Controlla i valori.');return;}db.pantry.unshift({name,k,c,p:pr,f});if(!persist()){db.pantry.shift();return;}$('pantryForm').reset();closeAllModals();renderPantry();toast('Salvato in Dispensa')});

function updateStepsPreview(){const d=current(),steps=stepExtra(d,$('stepsTotal').value),base=bmrEstimate(),active=activityKcal(d),ti=tefInfo(d),foodTef=ti.usableKcal,burn=Number.isFinite(base)&&Number.isFinite(steps.kcal)?base+active+steps.kcal+foodTef:null;$('stepsPreview').textContent=`${steps.band.label} · ${fmt(steps.total)} passi · stima: ${fmt(steps.kcal)} kcal.`;$('burnNum').textContent=Number.isFinite(burn)?fmt(burn):'—';}
